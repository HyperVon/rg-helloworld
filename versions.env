# Rube Goldberg Hello World — pinned toolchain baseline.
#
# No floating "latest" tags anywhere in this repository. Every tool and
# dependency is pinned to an exact version. CI reads these pins; local
# development uses the same versions where possible.
#
# Milestone 0 pins the language toolchains. Infrastructure tool versions are
# recorded below as planned pins for Milestone 2+.

# Languages and build tools
GO_VERSION=1.26.5
KOTLIN_VERSION=2.4.10
GRADLE_VERSION=9.6.1
JAVA_VERSION=21
MAVEN_VERSION=3.9.16
CMAKE_VERSION=4.4.2
CLANG_FORMAT_VERSION=22.1.8
DOTNET_SDK_VERSION=10.0.302
PYTHON_VERSION=3.13.14
RUBY_VERSION=3.4.10
RUST_VERSION=1.97.1
NODE_VERSION=24.19.0

# Language-level dependencies
TYPESCRIPT_VERSION=5.9.3
PRETTIER_VERSION=3.9.6
@TYPES_NODE_VERSION=26.1.2
RUFF_VERSION=0.16.1
RUBOCOP_VERSION=1.89.0
MINITEST_VERSION=6.0.6
RAKE_VERSION=13.2.1
JUNIT_JUPITER_VERSION=6.1.2
SPOTLESS_VERSION=3.9.0
XUNIT_VERSION=2.9.3
XUNIT_RUNNER_VERSION=3.1.5
DOTNET_TEST_SDK_VERSION=18.8.1

# Infrastructure (actual pins for Milestone 2+)
TERRAFORM_VERSION=1.15.8
K3D_VERSION=5.9.0
KUBECTL_VERSION=1.36.3
HELM_VERSION=4.2.3
COLIMA_VERSION=0.10.3
DOCKER_VERSION=29.5.2

# Terraform provider versions (Milestone 2)
TF_PROVIDER_KUBERNETES_VERSION=3.1.0
TF_PROVIDER_HELM_VERSION=2.11.0
TF_PROVIDER_KUBECTL_VERSION=1.17.0

# Helm chart versions (Milestone 2 platform services)
HELM_POSTGRESQL_VERSION=18.8.6
HELM_KAFKA_VERSION=32.4.3
HELM_REDIS_VERSION=27.0.18
HELM_MINIO_VERSION=17.0.21
HELM_REPO_BITNAMI=https://repo.broadcom.com/bitnami-files
HELM_REPO_MINIO=https://charts.min.io

# Application ports and bucket names
MINIO_BUCKET=rube-goldberg-artifacts
