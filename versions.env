# Rube Goldberg Hello World — pinned toolchain baseline.
#
# No floating "latest" tags anywhere in this repository. Every tool and
# dependency is pinned to an exact version. CI reads these pins; local
# development uses the same versions where possible.
#
# Milestone 0 pins the language toolchains. Infrastructure tool versions are
# recorded below as planned pins for Milestone 2+.

# Languages and build tools
GO_VERSION=1.26.5
KOTLIN_VERSION=2.4.10
GRADLE_VERSION=9.6.1
JAVA_VERSION=25
MAVEN_VERSION=3.9.16
CMAKE_VERSION=4.4.2
CLANG_FORMAT_VERSION=18 # CI installs clang-format-18 (Ubuntu noble); keep local install in sync
DOTNET_SDK_VERSION=10.0.302
PYTHON_VERSION=3.13.15
RUBY_VERSION=4.0.6
RUST_VERSION=1.97.1
NODE_VERSION=26.6.0
UV_VERSION=0.12.5

# Language-level dependencies
TYPESCRIPT_VERSION=7.0.2
PRETTIER_VERSION=3.9.6
TYPES_NODE_VERSION=26.1.2
RUFF_VERSION=0.16.1
RUBOCOP_VERSION=1.89.0
MINITEST_VERSION=6.0.6
RAKE_VERSION=13.4.2
JUNIT_JUPITER_VERSION=6.1.2
SPOTLESS_VERSION=3.9.0
XUNIT_VERSION=2.9.3
XUNIT_RUNNER_VERSION=3.1.5
DOTNET_TEST_SDK_VERSION=18.8.1
KAFKAJS_VERSION=2.2.4
KOTLIN_KTOR_VERSION=3.5.2
KAFKA_CLIENTS_VERSION=4.3.1
LETTUCE_VERSION=7.6.0.RELEASE
SPRING_BOOT_VERSION=4.1.0
SPRING_WS_VERSION=5.0.2
WSDL4J_VERSION=1.6.3
H2_VERSION=2.4.240
JAXWS_VERSION=4.0.5
JAKARTA_XML_WS_API_VERSION=4.0.3
JAKARTA_JWS_API_VERSION=3.0.0
JAXB_RUNTIME_VERSION=4.0.6
JAXB2_MAVEN_PLUGIN_VERSION=4.0.16

# Milestone 5 worker dependencies
# librdkafka powers the C++ geometry engine (homebrew version on macOS;
# Ubuntu CI pins the noble apt package below).
LIBRDKAFKA_VERSION=2.15.0
LIBRDKAFKA_UBUNTU_VERSION=2.3.0-1build2
LIBRDKAFKA_DEBIAN_VERSION=2.0.2-1
# Go vector-normalizer dependencies (pinned in go.mod/go.sum)
FRANZ_GO_VERSION=1.21.5
MINIO_GO_VERSION=7.2.1
KADM_VERSION=1.18.0
KFAKE_VERSION=v0.0.0-20260804154521-adb3a18abe14

# Milestone 6 rasterization dependencies
# protoc toolchain regenerates the Go gRPC client from the rasterizer proto
# (scripts/gen-proto.sh); the C# side generates at build time via Grpc.Tools.
PROTOC_VERSION=35.1
PROTOC_GEN_GO_VERSION=v1.36.11
PROTOC_GEN_GO_GRPC_VERSION=v1.6.2
GRPC_GO_VERSION=v1.83.0
GOOGLE_PROTOBUF_GO_VERSION=v1.36.11
# .NET rasterizer (pinned in NuGet lock files)
GRPC_ASPNETCORE_VERSION=2.83.0
GRPC_TOOLS_VERSION=2.83.0
IMAGESHARP_VERSION=3.1.12
IMAGESHARP_DRAWING_VERSION=2.1.7
MINIO_DOTNET_VERSION=7.0.0
# Rasterizer container base images (never "latest")
DOTNET_SDK_IMAGE_VERSION=10.0.302
DOTNET_ASPNET_IMAGE_VERSION=10.0.9

# Milestone 7 image pipeline dependencies
PILLOW_VERSION=12.3.0
NUMPY_VERSION=2.3.5
SCIKIT_IMAGE_VERSION=0.25.2
AIOKAFKA_VERSION=0.12.0
MINIO_PY_VERSION=7.2.12

# Milestone 8 OCR worker dependencies
TESSERACT_VERSION=5.9.0
TESSERACT_OCR_LIB_VERSION=5.9.0
MINIO_NODE_VERSION=8.0.7
MINIO_JAVA_VERSION=8.5.17

# Milestone 8 adjudicator dependencies
BUNDLER_VERSION=4.0.16
RDKAFKA_GEM_VERSION=0.29.0

# Milestone 10 UI dependencies
REDIS_NODE_VERSION=4.7.1
REDIS_STREAMS_SSE_VERSION=0.5.0-milestone10
REACT_FLOW_VERSION=11.11.4
REACT_VERSION=19.0.0
VITE_VERSION=6.4.3
ANGULAR_TELEMETRY_VERSION=0.5.0-milestone10
ARTIFACT_INSPECTOR_VERSION=0.5.0-milestone10

# Infrastructure (pinned; installed by make setup)
TERRAFORM_VERSION=1.15.8
K3D_VERSION=5.9.0
KUBECTL_VERSION=1.36.3
HELM_VERSION=4.2.3
COLIMA_VERSION=0.10.3
DOCKER_VERSION=29.7.1

# Official SHA-256 digests for the Linux artifacts above, verified by
# scripts/install-prerequisites.sh before anything is installed as root.
# Refresh together with the version bump (sources: go.dev/dl JSON API,
# dl.k8s.io/*.sha256, k3d release checksums.txt, HashiCorp SHA256SUMS,
# get.helm.sh *.sha256sum).
GO_SHA256_LINUX_AMD64=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
