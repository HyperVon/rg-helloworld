# Milestone 11 Observability dependencies
OTEL_SDK_VERSION=1.54.0
OTEL_EXPORTER_OTLP_VERSION=1.54.0
OTEL_EXPORTER_OTLPHTTP_VERSION=0.59.0
OTEL_COLLECTOR_VERSION=0.128.0
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.0.2
LOKI_VERSION=3.5.2
TEMPO_VERSION=2.4.0
GRAFANA_OLAP_PLUGIN_VERSION=0.10.0

# Milestone 11 Ruby (adjudicator-ruby, artifact-inspector-ruby) OTLP telemetry
OTEL_RUBY_SDK_VERSION=1.13.0
OTEL_RUBY_EXPORTER_OTLP_VERSION=0.34.1
OTEL_RUBY_LOGS_SDK_VERSION=0.6.1
OTEL_RUBY_EXPORTER_OTLP_LOGS_VERSION=0.5.1
OTEL_RUBY_INSTRUMENTATION_ALL_VERSION=0.95.0

# Per-language OpenTelemetry SDK versions (read from each service's lockfile).
# OTEL_SDK_VERSION above reflects the JVM SDK (1.54.0) used by glyph-catalog-java
# and run-orchestrator-kotlin. The remaining languages pin their own OTel SDKs:
OTEL_SDK_VERSION_JS=0.221.0        # @opentelemetry/sdk-node (event-gateway, ocr-worker, telemetry-element, web-shell)
OTEL_SDK_VERSION_PYTHON=1.34.1     # opentelemetry-sdk (image-pipeline-python)
OTEL_SDK_VERSION_GO=1.44.0         # go.opentelemetry.io/otel/sdk (vector-normalizer-go, cmd/rghw)
OTEL_SDK_VERSION_DOTNET=1.15.3     # OpenTelemetry (rasterizer-dotnet)
OTEL_SDK_VERSION_RUST=0.32.1       # opentelemetry_sdk (phrase-assembler-rust)

# Debian runtime base image patch (used by go/rust/debian-slim runtime stages).
# Temurin JVM and gcc images remain major/patch pinned inline; Debian tracks the
# latest bookworm point release.
DEBIAN_IMAGE_VERSION=12.11
