{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": ["AGENTS.md", ".kilo/operating.md"],
  "skills": {
    "paths": [".agents/skills", ".kilo/skills"]
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "kilo": {
      "options": {
        "timeout": false,
        "chunkTimeout": 120000,
        "headerTimeout": 60000
      }
    }
  },
  "lsp": false,
  "plugin": [
    "context-mode",
    "@tarquinen/opencode-dcp"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "kops": {
      "type": "local",
      "command": ["uv", "--directory", "/Users/charlesv/.local/share/kilo/mcp-servers/kops", "run", "kops"],
      "enabled": true
    }
  },
  "permission": {
    "kafka_create_topic": "deny",
    "kafka_delete_topic": "deny",
    "kafka_create_partitions": "deny",
    "kafka_alter_configs": "deny",
    "kafka_produce_message": "deny",
    "kafka_reset_consumer_group_offset": "deny",
    "kafka_rewind_consumer_group_offset_by_timestamp": "deny"
  }
}
