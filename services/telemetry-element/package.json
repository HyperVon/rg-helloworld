{
  "name": "rg-telemetry-element",
  "version": "0.5.0-milestone11",
  "private": true,
  "description": "Angular-style telemetry custom element for Rube Goldberg Hello World (Milestone 10)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --build --watch",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"out/tests/*.test.js\"",
    "coverage": "npm run build && tsc -p tsconfig.test.json && c8 node --test \"out/tests/*.test.js\"",
    "lint": "prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "main": "out/index.js",
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.221.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.221.0",
    "@opentelemetry/sdk-logs": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@types/node": "26.1.2",
    "c8": "12.0.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
