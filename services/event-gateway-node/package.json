{
  "name": "rg-event-gateway",
  "version": "0.0.0-skeleton",
  "description": "Browser event gateway (Milestone 0 skeleton)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \"out/tests/*.test.js\"",
    "coverage": "npm run build && tsc -p tsconfig.test.json && c8 node --test \"out/tests/*.test.js\"",
    "lint": "prettier --check . && npm run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "c8": "12.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
