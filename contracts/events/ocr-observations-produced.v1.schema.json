{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rghello.dev/schemas/events/ocr-observations-produced.v1.schema.json",
  "title": "OcrObservationsProduced",
  "description": "Event published by the Node OCR worker with raw OCR observations (topic rg.ocr-observations.v1). Must not contain expected characters (section 7.3)",
  "type": "object",
  "required": [
    "runId",
    "stepId",
    "attempt",
    "inputMaturity",
    "outputMaturity",
    "inputArtifacts",
    "outputArtifacts",
    "transformation",
    "observations"
  ],
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "inputMaturity": { "type": "integer", "const": 60 },
    "outputMaturity": { "type": "integer", "const": 70 },
    "inputArtifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputArtifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "transformation": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "const": "perform-ocr" },
        "version": { "type": "string" }
      }
    },
    "observations": {
      "type": "object",
      "required": ["fullPhrase", "positionObservations"],
      "additionalProperties": false,
      "properties": {
        "fullPhrase": {
          "type": "object",
          "required": ["rawText", "confidence", "symbols"],
          "additionalProperties": false,
          "properties": {
            "rawText": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
            "symbols": { "type": "array", "items": { "type": "object" } }
          }
        },
        "positionObservations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["position", "candidate", "confidence", "alternatives"],
            "additionalProperties": false,
            "properties": {
              "position": { "type": "integer", "minimum": 0 },
              "candidate": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "alternatives": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
