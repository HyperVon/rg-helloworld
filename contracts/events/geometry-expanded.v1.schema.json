{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rghw.dev/schemas/events/geometry-expanded.v1.schema.json",
  "title": "GeometryExpanded",
  "description": "Event published by the C++ geometry engine after expanding glyph primitives into explicit segments (topic rg.geometry-expanded.v1)",
  "type": "object",
  "required": [
    "runId",
    "stepId",
    "glyphInstanceId",
    "position",
    "attempt",
    "inputMaturity",
    "outputMaturity",
    "inputArtifacts",
    "outputArtifacts",
    "transformation",
    "geometry"
  ],
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "glyphInstanceId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "position": { "type": "integer", "minimum": 0 },
    "attempt": { "type": "integer", "minimum": 1 },
    "inputMaturity": { "type": "integer", "const": 10 },
    "outputMaturity": { "type": "integer", "const": 20 },
    "inputArtifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outputArtifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "transformation": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "const": "expand-geometry" },
        "version": { "type": "string" }
      }
    },
    "geometry": {
      "type": "object",
      "required": ["kind", "segments", "boundingBox", "totalLength", "geometrySha256"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["DRAWABLE_GEOMETRY", "GAP_GEOMETRY"] },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x1", "y1", "x2", "y2"],
            "additionalProperties": false,
            "properties": {
              "x1": { "type": "number" },
              "y1": { "type": "number" },
              "x2": { "type": "number" },
              "y2": { "type": "number" }
            }
          }
        },
        "boundingBox": {
          "type": "object",
          "required": ["xMin", "yMin", "xMax", "yMax"],
          "additionalProperties": false,
          "properties": {
            "xMin": { "type": "number" },
            "yMin": { "type": "number" },
            "xMax": { "type": "number" },
            "yMax": { "type": "number" }
          }
        },
        "advanceWidth": { "type": "number" },
        "totalLength": { "type": "number" },
        "segmentCount": { "type": "integer", "minimum": 0 },
        "geometrySha256": { "type": "string" }
      }
    }
  }
}
