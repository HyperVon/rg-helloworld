{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rghw.dev/schemas/events/phrase-composition-scheduled.v1.schema.json",
  "title": "PhraseCompositionScheduled",
  "description": "Event published by the orchestrator to schedule phrase composition (topic rg.phrase-composition.v1)",
  "type": "object",
  "required": [
    "runId",
    "stepId",
    "attempt",
    "inputMaturity",
    "outputMaturity",
    "inputArtifacts",
    "outputArtifacts",
    "transformation",
    "compositionPlan"
  ],
  "additionalProperties": true,
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "inputMaturity": {
      "type": "integer",
      "const": 40
    },
    "outputMaturity": {
      "type": "integer",
      "const": 50
    },
    "inputArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputArtifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transformation": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "const": "schedule-composition"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "compositionPlan": {
      "type": "object",
      "required": [
        "positions",
        "baseline"
      ],
      "additionalProperties": false,
      "properties": {
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "position",
              "artifactRef"
            ],
            "additionalProperties": false,
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "glyphInstanceId": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
              },
              "artifactRef": {
                "type": "string"
              },
              "advanceWidth": {
                "type": "number"
              }
            }
          }
        },
        "baseline": {
          "type": "number"
        },
        "canvasWidth": {
          "type": "integer",
          "minimum": 1
        },
        "canvasHeight": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$comment": "Validates the event data payload only. The CloudEvents envelope (see cloudevents-envelope.json) is validated separately; envelope fields are permitted as additional properties."
}
